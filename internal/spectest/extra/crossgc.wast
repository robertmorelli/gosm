;; GC values crossing module boundaries (requires modules compiled together).
(module
  (type $Point (struct (field i32) (field i32)))
  (type $Shape (sub (struct (field i32))))
  (type $Circle (sub $Shape (struct (field i32) (field f64))))
  (func (export "make") (param i32 i32) (result (ref $Point))
    (struct.new $Point (local.get 0) (local.get 1)))
  (func (export "circle") (result (ref $Shape))
    (struct.new $Circle (i32.const 7) (f64.const 2.5)))
  (func (export "point-any") (result anyref)
    (struct.new $Point (i32.const 1) (i32.const 2)))
  (func (export "x") (param (ref null $Point)) (result i32)
    (struct.get $Point 0 (local.get 0)))
)
(register "A")
(module
  (type $Point (struct (field i32) (field i32)))
  (type $Shape (sub (struct (field i32))))
  (type $Circle (sub $Shape (struct (field i32) (field f64))))
  (import "A" "make" (func $make (param i32 i32) (result (ref $Point))))
  (import "A" "circle" (func $circle (result (ref $Shape))))
  (import "A" "point-any" (func $pany (result anyref)))
  (import "A" "x" (func $x (param (ref null $Point)) (result i32)))
  (func (export "sum") (result i32)
    (local $p (ref null $Point))
    (local.set $p (call $make (i32.const 3) (i32.const 4)))
    (i32.add (struct.get $Point 0 (local.get $p)) (struct.get $Point 1 (local.get $p))))
  (func (export "radius") (result f64)
    (struct.get $Circle 1 (ref.cast (ref $Circle) (call $circle))))
  (func (export "is-point") (result i32) (ref.test (ref $Point) (call $pany)))
  (func (export "is-circle") (result i32) (ref.test (ref $Circle) (call $pany)))
  (func (export "pass-back") (result i32)
    (call $x (struct.new $Point (i32.const 99) (i32.const 0))))
)
(assert_return (invoke "sum") (i32.const 7))
(assert_return (invoke "radius") (f64.const 2.5))
(assert_return (invoke "is-point") (i32.const 1))
(assert_return (invoke "is-circle") (i32.const 0))
(assert_return (invoke "pass-back") (i32.const 99))
