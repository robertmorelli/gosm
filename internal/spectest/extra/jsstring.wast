;; JS String Builtins and imported string constants (wasm:js-string, "'").
(module
  (type $chars (array (mut i16)))
  (import "wasm:js-string" "fromCharCode" (func $fromCharCode (param i32) (result (ref extern))))
  (import "wasm:js-string" "fromCodePoint" (func $fromCodePoint (param i32) (result (ref extern))))
  (import "wasm:js-string" "concat" (func $concat (param externref externref) (result (ref extern))))
  (import "wasm:js-string" "length" (func $length (param externref) (result i32)))
  (import "wasm:js-string" "charCodeAt" (func $charCodeAt (param externref i32) (result i32)))
  (import "wasm:js-string" "codePointAt" (func $codePointAt (param externref i32) (result i32)))
  (import "wasm:js-string" "substring" (func $substring (param externref i32 i32) (result (ref extern))))
  (import "wasm:js-string" "equals" (func $equals (param externref externref) (result i32)))
  (import "wasm:js-string" "compare" (func $compare (param externref externref) (result i32)))
  (import "wasm:js-string" "test" (func $test (param externref) (result i32)))
  (import "wasm:js-string" "cast" (func $cast (param externref) (result (ref extern))))
  (import "wasm:js-string" "fromCharCodeArray" (func $fromArr (param (ref null $chars) i32 i32) (result (ref extern))))
  (import "wasm:js-string" "intoCharCodeArray" (func $intoArr (param externref (ref null $chars) i32) (result i32)))
  (import "'" "héllo" (global $hello externref))
  (import "'" "😀" (global $smile externref))

  (func (export "len-hello") (result i32) (call $length (global.get $hello)))
  (func (export "len-smile") (result i32) (call $length (global.get $smile)))
  (func (export "char-e") (result i32) (call $charCodeAt (global.get $hello) (i32.const 1)))
  (func (export "smile-units") (result i32 i32)
    (call $charCodeAt (global.get $smile) (i32.const 0))
    (call $charCodeAt (global.get $smile) (i32.const 1)))
  (func (export "smile-cp") (result i32) (call $codePointAt (global.get $smile) (i32.const 0)))
  (func (export "split-and-join") (result i32)
    ;; splitting a surrogate pair and concatenating it back must equal the original
    (call $equals
      (call $concat
        (call $substring (global.get $smile) (i32.const 0) (i32.const 1))
        (call $substring (global.get $smile) (i32.const 1) (i32.const 2)))
      (global.get $smile)))
  (func (export "build") (result i32)
    (local $s externref)
    (local.set $s (call $concat (call $fromCharCode (i32.const 72)) (call $fromCodePoint (i32.const 0x1F600))))
    (call $length (local.get $s)))
  (func (export "roundtrip-array") (result i32)
    (local $a (ref $chars))
    (local.set $a (array.new_default $chars (i32.const 8)))
    (drop (call $intoArr (global.get $hello) (local.get $a) (i32.const 0)))
    (call $equals (call $fromArr (local.get $a) (i32.const 0) (i32.const 5)) (global.get $hello)))
  (func (export "compare") (result i32 i32 i32)
    (call $compare (call $fromCharCode (i32.const 97)) (call $fromCharCode (i32.const 98)))
    (call $compare (global.get $hello) (global.get $hello))
    (call $compare (call $fromCharCode (i32.const 0xFFFF)) (global.get $smile)))
  (func (export "test-null") (result i32) (call $test (ref.null extern)))
  (func (export "cast-null") (drop (call $cast (ref.null extern))))
  (func (export "char-oob") (result i32) (call $charCodeAt (global.get $hello) (i32.const 99)))
)
(assert_return (invoke "len-hello") (i32.const 5))
(assert_return (invoke "len-smile") (i32.const 2))
(assert_return (invoke "char-e") (i32.const 0xE9))
(assert_return (invoke "smile-units") (i32.const 0xD83D) (i32.const 0xDE00))
(assert_return (invoke "smile-cp") (i32.const 0x1F600))
(assert_return (invoke "split-and-join") (i32.const 1))
(assert_return (invoke "build") (i32.const 3))
(assert_return (invoke "roundtrip-array") (i32.const 1))
(assert_return (invoke "compare") (i32.const -1) (i32.const 0) (i32.const 1))
(assert_return (invoke "test-null") (i32.const 0))
(assert_trap (invoke "cast-null") "not a string")
(assert_trap (invoke "char-oob") "index out of bounds")
